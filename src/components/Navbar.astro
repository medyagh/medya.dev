---
import { achievementCount } from '../data/achievements';
import { projectCount } from '../data/projects';
import { talksAndMediaCount } from '../data/talks';
import { withBase } from '../utils/paths';

const base = import.meta.env.BASE_URL;
const normalizedBase = base.endsWith('/') ? base.slice(0, -1) : base;
const pathname = new URL(Astro.request.url).pathname;
const relativePath = normalizedBase && pathname.startsWith(normalizedBase)
  ? pathname.slice(normalizedBase.length)
  : pathname;
const currentPath = relativePath.replace(/^\/+/, ''); // remove leading slash(es)
const countedPages = [
  { path: 'projects', label: 'Projects', count: projectCount },
  { path: 'achievements', label: 'Achievements', count: achievementCount },
  { path: 'talks', label: 'Talks', count: talksAndMediaCount },
];
---

<nav class="navbar glass-panel">
  <div class="container nav-container">
    <a href={withBase('/')} class="logo text-gradient" aria-label="medya.dev home">medya.dev</a>
    <ul class="nav-links" id="nav-links">
      {countedPages.map(({ path, label, count }) => {
        const isCurrent = currentPath.replace(/\/+$/, '') === path;
        const countLabel = `${label}, ${count}`;
        return (
          <li>
            <a
              href={withBase(path)}
              class:list={['counted-link', { active: isCurrent }]}
              aria-current={isCurrent ? 'page' : undefined}
              aria-label={countLabel}
              data-count-label={countLabel}
            >
              {label}
              <span class="nav-count" aria-hidden="true">{count}</span>
            </a>
          </li>
        );
      })}
      <li><a href={withBase('/blog')} class={currentPath.startsWith("blog") ? "active" : ""}>Blog</a></li>
      <li><a href={withBase('/about')} class={currentPath.startsWith("about") ? "active" : ""}>Contact</a></li>
    </ul>
    <button
      type="button"
      class="mobile-menu-btn"
      aria-label="Toggle menu"
      aria-controls="nav-links"
      aria-expanded="false"
    >
      <svg class="icon-menu" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      <svg class="icon-close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>
</nav>

<script>
  const countedLinkSelector = 'a[data-count-label]';
  const seenPaths = new Set<string>();

  function updateNavCounts({ reset = false, openedLink }: { reset?: boolean; openedLink?: HTMLAnchorElement } = {}) {
    const currentPath = window.location.pathname.replace(/\/+$/, '');

    for (const link of document.querySelectorAll<HTMLAnchorElement>(countedLinkSelector)) {
      const path = new URL(link.href).pathname.replace(/\/+$/, '');
      const storageKey = `medya-nav-seen:${path}`;
      const opened = path === currentPath || link === openedLink;
      let seen = opened || (!reset && seenPaths.has(path));

      try {
        if (opened) {
          sessionStorage.setItem(storageKey, 'true');
        } else if (reset) {
          sessionStorage.removeItem(storageKey);
        }
        seen = opened || sessionStorage.getItem(storageKey) === 'true';
      } catch {
        // Keep the badge state for this page when session storage is unavailable.
      }

      if (seen) seenPaths.add(path);
      else seenPaths.delete(path);
      link.toggleAttribute('data-unseen', !seen);
      link.setAttribute('aria-label', `${link.dataset.countLabel}${seen ? ', viewed' : ' to explore'}`);
    }
  }

  function markCountedPageOpened(event: MouseEvent) {
    if (event.button > 1 || !(event.target instanceof Element)) return;
    const link = event.target.closest<HTMLAnchorElement>(countedLinkSelector);
    if (link) updateNavCounts({ openedLink: link });
  }

  function initMobileMenu() {
    const menuBtn = document.querySelector<HTMLButtonElement>('.mobile-menu-btn');
    const navLinks = document.querySelector<HTMLElement>('#nav-links');
    if (!menuBtn || !navLinks) return;

    menuBtn.addEventListener('click', () => {
      const isOpen = navLinks.classList.toggle('open');
      menuBtn.classList.toggle('open', isOpen);
      menuBtn.setAttribute('aria-expanded', String(isOpen));
    });

    navLinks.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) {
        navLinks.classList.remove('open');
        menuBtn.classList.remove('open');
        menuBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  const navigation = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
  const internalReferrer = document.referrer && new URL(document.referrer).origin === window.location.origin;

  initMobileMenu();
  updateNavCounts({ reset: navigation?.type === 'navigate' && !internalReferrer });
  document.addEventListener('astro:after-swap', initMobileMenu);
  document.addEventListener('astro:after-swap', () => updateNavCounts());
  document.addEventListener('click', markCountedPageOpened);
  document.addEventListener('auxclick', markCountedPageOpened);
  window.addEventListener('pageshow', () => updateNavCounts());
</script>

<style>
  .navbar {
    position: fixed;
    top: 1rem;
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% - 2rem);
    max-width: var(--max-width);
    height: 60px;
    z-index: 1000;
    border-radius: 30px; /* Pill shape */
    display: flex;
    align-items: center;
  }

  .nav-container {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 0 1.5rem;
  }

  .logo {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.5px;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-links a {
    color: var(--text-secondary);
    font-weight: 500;
    font-size: 0.95rem;
    position: relative;
    padding: 0.5rem 0;
  }

  .nav-links a:hover, .nav-links a.active {
    color: var(--text-primary);
  }

  .nav-count {
    position: absolute;
    top: -0.1rem;
    left: calc(100% + 0.125rem);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.3rem;
    height: 1.3rem;
    padding: 0 0.25rem;
    border-radius: 999px;
    background: var(--border-color);
    color: var(--text-secondary);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .counted-link[data-unseen] .nav-count {
    background: #b91c1c;
    color: white;
  }

  .nav-links a.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--accent-color);
    border-radius: 2px;
  }

  .mobile-menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 0.5rem;
    margin: 0;
    color: var(--text-primary);
    cursor: pointer;
  }

  .mobile-menu-btn .icon-close {
    display: none;
  }

  .mobile-menu-btn.open .icon-menu {
    display: none;
  }

  .mobile-menu-btn.open .icon-close {
    display: block;
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
      position: absolute;
      top: calc(100% + 0.75rem);
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      padding: 0.5rem;
      background: var(--surface-color);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    }

    .nav-links.open {
      display: flex;
    }

    .nav-links li {
      width: 100%;
    }

    .nav-links a {
      display: block;
      padding: 0.85rem 1rem;
      border-radius: 10px;
    }

    .nav-links .counted-link {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .nav-count {
      position: static;
    }

    .nav-links a:hover,
    .nav-links a.active {
      background: rgba(2, 132, 199, 0.08);
    }

    .nav-links a.active::after {
      display: none;
    }

    .mobile-menu-btn {
      display: flex;
    }
  }
</style>
