---
import { withBase } from '../utils/paths';

const base = import.meta.env.BASE_URL;
const normalizedBase = base.endsWith('/') ? base.slice(0, -1) : base;
const pathname = new URL(Astro.request.url).pathname;
const relativePath = normalizedBase && pathname.startsWith(normalizedBase)
  ? pathname.slice(normalizedBase.length)
  : pathname;
const currentPath = relativePath.replace(/^\/+/, ''); // remove leading slash(es)
---

<nav class="navbar glass-panel">
  <div class="container nav-container">
    <a href={withBase('/')} class="logo text-gradient">medya.dev</a>
    <ul class="nav-links">
      <li><a href={withBase('/')} class={currentPath === "" ? "active" : ""}>Home</a></li>
      <li><a href={withBase('/projects')} class={currentPath.startsWith("projects") ? "active" : ""}>Projects</a></li>
      <li><a href={withBase('/achievements')} class={currentPath.startsWith("achievements") ? "active" : ""}>Achievements</a></li>
      <li><a href={withBase('/talks')} class={currentPath.startsWith("talks") ? "active" : ""}>Talks</a></li>
      <li><a href={withBase('/blog')} class={currentPath.startsWith("blog") ? "active" : ""}>Blog</a></li>
      <li><a href={withBase('/about')} class={currentPath.startsWith("about") ? "active" : ""}>About</a></li>
    </ul>
    <div class="mobile-menu-btn">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
    </div>
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 1rem;
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% - 2rem);
    max-width: var(--max-width);
    height: 60px;
    z-index: 1000;
    border-radius: 30px; /* Pill shape */
    display: flex;
    align-items: center;
  }

  .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 0 1.5rem;
  }

  .logo {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.5px;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-links a {
    color: var(--text-secondary);
    font-weight: 500;
    font-size: 0.95rem;
    position: relative;
    padding: 0.5rem 0;
  }

  .nav-links a:hover, .nav-links a.active {
    color: var(--text-primary);
  }

  .nav-links a.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--accent-color);
    border-radius: 2px;
  }

  .mobile-menu-btn {
    display: none;
    cursor: pointer;
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none; /* In a real app, we'd add JS to toggle a mobile menu */
    }
    .mobile-menu-btn {
      display: block;
    }
  }
</style>
