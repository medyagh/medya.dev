---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
---

<Layout title="Home">
  <div class="container hero-section">
    <div class="hero-content glass-panel">
      <div class="hero-text">
        <h1 class="text-gradient">Medya Ghazizadeh</h1>
        <p class="subtitle">AI Pioneer & Technical Lead at Google</p>
        
        <div class="stats-grid">
          <div class="stat-item">
            <span class="stat-value">8.5+</span>
            <span class="stat-label">Years at Google</span>
          </div>
          <div class="stat-item">
            <span class="stat-value">Top 5</span>
            <span class="stat-label">K8s Contributor</span>
          </div>
          <div class="stat-item">
            <span class="stat-value">Millions</span>
            <span class="stat-label">Minikube Users</span>
          </div>
          <div class="stat-item">
            <span class="stat-value">Top 4%</span>
            <span class="stat-label">CodersRank</span>
          </div>
        </div>

        <div class="bio-section">
          <p>
            I am a Senior Software Engineer and Technical Lead at Google, where I have spent the last 8.5 years pioneering AI and Kubernetes infrastructure. As the lead of the <strong>minikube</strong> project since 2019, I've grown its user base from 35K to millions and shipped hundreds of versions, enabling seamless local Kubernetes development worldwide.
          </p>
          <p>
            Recently, I have been pioneering AI integration in Kubernetes, leading technical initiatives for Gemini Cloud Assist and bringing GPU capabilities to local Kubernetes environments. I have also shared these innovations and my open-source work at dozens of conferences and talks globally.
          </p>
        </div>

        <div class="action-buttons">
          <a href="/achievements" class="btn btn-primary">View Achievements</a>
          <a href="/talks" class="btn btn-outline">Watch Talks</a>
        </div>
      </div>
      <div class="hero-image-wrapper">
        <img src="/profile_pic.jpeg" alt="Medya Ghazizadeh" class="hero-image" />
        <div class="glass-decoration"></div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .hero-section {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - var(--nav-height) - 4rem);
  }

  .hero-content {
    display: flex;
    flex-direction: column-reverse;
    gap: 3rem;
    padding: 3rem;
    width: 100%;
  }

  @media (min-width: 900px) {
    .hero-content {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 4rem;
    }
  }

  .hero-text {
    flex: 1;
    max-width: 600px;
  }

  .subtitle {
    font-size: 1.25rem;
    color: var(--text-secondary);
    margin-bottom: 2rem;
    font-weight: 500;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 500px) {
    .stats-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat-item {
    display: flex;
    flex-direction: column;
  }

  .stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent-color);
  }

  .stat-label {
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
  }

  .bio-section {
    margin-bottom: 2rem;
  }

  .bio-section p {
    margin-bottom: 1rem;
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .action-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-image-wrapper {
    position: relative;
    width: 250px;
    height: 250px;
    margin: 0 auto;
  }

  @media (min-width: 900px) {
    .hero-image-wrapper {
      width: 350px;
      height: 350px;
    }
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 24px;
    position: relative;
    z-index: 2;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
  }

  .glass-decoration {
    position: absolute;
    top: -20px;
    right: -20px;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--accent-color) 0%, #0ea5e9 100%);
    border-radius: 24px;
    z-index: 1;
    opacity: 0.2;
    filter: blur(20px);
  }
</style>
