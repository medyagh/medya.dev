---
import Layout from '../layouts/Layout.astro';
import data from '../data/parsed_excel.json';
import { withBase } from '../utils/paths';

const externalAwards = data['Awards and Recognitions'] || [];
const internalAwards = data['(Internal Google) Awards'] || [];
---

<Layout title="Achievements">
  <div class="container">
    <header class="page-header">
      <h1 class="text-gradient">Achievements & Projects</h1>
      <p class="subtitle">A timeline of awards, recognition, and open source impact.</p>
    </header>

    <section class="achievements-section">
      <h2>Awards and Recognitions</h2>
      <div class="cards-grid">
        <div class="card glass-panel">
          <div class="card-header">
            <h3>CNCF Contributor Card</h3>
            <span class="badge">CNCF</span>
          </div>
          <a
            href="https://contribcard.cncf.io/medyagh"
            target="_blank"
            rel="noopener noreferrer"
            class="cncf-card-thumb-link"
          >
            <img
              src={withBase('/cncf_contributor_card.png')}
              alt="CNCF Contributor Card for medyagh — 7.5k contributions to 36 repositories over 10 years"
              class="cncf-card-thumb"
            />
          </a>
          <p class="description">7,500+ contributions across 36 CNCF repositories since 2017.</p>
          <a href="https://contribcard.cncf.io/medyagh" target="_blank" rel="noopener noreferrer" class="link-btn">View Live Card ↗</a>
        </div>
        {externalAwards.map((award) => (
          <div class="card glass-panel">
            <div class="card-header">
              <h3>{award.Name}</h3>
              <span class="badge">{award.Entity || 'Global'}</span>
            </div>
            <p class="date">{award.Date && String(award.Date).substring(0, 10)}</p>
            {award.Link && award.Link.startsWith('http') && (
              <a href={award.Link} target="_blank" rel="noopener noreferrer" class="link-btn">View Evidence ↗</a>
            )}
            {award.Link && award.Link.startsWith('/') && (
              <a href={withBase(award.Link)} target="_blank" rel="noopener noreferrer" class="link-btn">View Evidence ↗</a>
            )}
          </div>
        ))}
      </div>
    </section>

    <section class="achievements-section">
      <h2>Google Awards (Spot Bonuses & Feats of Engineering)</h2>
      <div class="cards-grid">
        {internalAwards.map((award) => (
          <div class="card glass-panel">
            <div class="card-header">
              <h3>{award['Award / Recognition']}</h3>
              <span class="badge internal">{award.Type}</span>
            </div>
            <p class="date">{award.Date && String(award.Date).substring(0, 10)}</p>
            <p class="description">{award['What It Recognized']}</p>
            <p class="meta">Given by: {award['Given By']} ({award['Their Role']})</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .page-header {
    margin-bottom: 4rem;
    text-align: center;
  }

  .subtitle {
    font-size: 1.25rem;
    color: var(--text-secondary);
    margin-top: 1rem;
  }

  .achievements-section {
    margin-bottom: 5rem;
  }

  .cncf-card-thumb-link {
    display: block;
    margin-bottom: 1rem;
    border-radius: 10px;
    overflow: hidden;
    transition: transform var(--transition-smooth);
  }

  .cncf-card-thumb-link:hover {
    transform: translateY(-3px);
  }

  .cncf-card-thumb {
    display: block;
    width: 100%;
    height: 220px;
    object-fit: cover;
    object-position: top;
    border-radius: 10px;
  }

  .achievements-section h2 {
    margin-bottom: 2rem;
    font-size: 2rem;
    color: var(--text-primary);
  }

  .cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform var(--transition-smooth), box-shadow var(--transition-smooth);
  }

  .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .card h3 {
    font-size: 1.25rem;
    margin: 0;
  }

  .badge {
    background-color: var(--text-primary);
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .badge.internal {
    background-color: #0d9488;
  }

  .badge.tech {
    background-color: var(--accent-color);
  }

  .date {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .description {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .meta {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .repo-stats {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .link-btn {
    display: inline-block;
    margin-top: auto;
    font-weight: 600;
    font-size: 0.9rem;
  }
</style>
