---
import Layout from '../layouts/Layout.astro';
import { achievementCount, externalAwards, featuredAchievements, internalAwards } from '../data/achievements';
import { withBase } from '../utils/paths';
---

<Layout title="Achievements">
  <div class="container">
    <header class="page-header">
      <h1 class="text-gradient">Achievements</h1>
      <p class="achievement-count">
        <strong>{achievementCount}</strong>
        <span>highlights</span>
      </p>
    </header>

    <section class="achievements-section">
      <h2>Open Source & Industry</h2>
      <div class="cards-grid">
        {featuredAchievements.map((achievement) => (
          <article class="card glass-panel">
            <div class="card-header">
              <h3>{achievement.title}</h3>
              <span class="badge">{achievement.organization}</span>
            </div>
            <a
              href={achievement.imageLink ?? withBase(achievement.image)}
              target="_blank"
              rel="noopener noreferrer"
              class="card-image-link"
              aria-label={achievement.imageLinkLabel}
            >
              <img
                src={withBase(achievement.image)}
                alt={achievement.imageAlt}
                class="card-image"
                loading="lazy"
              />
            </a>
            {achievement.date && <p class="date">{achievement.date}</p>}
            <p class="description">{achievement.description}</p>
            <a href={achievement.link} target="_blank" rel="noopener noreferrer" class="link-btn">{achievement.linkLabel} ↗</a>
          </article>
        ))}
        {externalAwards.map((award) => (
          <div class="card glass-panel">
            <div class="card-header">
              <h3>{award.Name}</h3>
              <span class="badge">{award.Entity || 'Global'}</span>
            </div>
            {award.Image && (
              <a
                href={award.Link}
                target="_blank"
                rel="noopener noreferrer"
                class="card-image-link"
                aria-label={`Read about ${award.Name}`}
              >
                <img
                  src={withBase(award.Image)}
                  alt={`${award.Name} badge`}
                  class="card-image"
                  loading="lazy"
                />
              </a>
            )}
            <p class="date">{award.Date && String(award.Date).substring(0, 10)}</p>
            {award.Link && award.Link.startsWith('http') && (
              <a href={award.Link} target="_blank" rel="noopener noreferrer" class="link-btn">View Evidence ↗</a>
            )}
            {award.Link && award.Link.startsWith('/') && (
              <a href={withBase(award.Link)} target="_blank" rel="noopener noreferrer" class="link-btn">View Evidence ↗</a>
            )}
          </div>
        ))}
      </div>
    </section>

    <section class="achievements-section">
      <h2>Google Awards</h2>
      <div class="cards-grid">
        {internalAwards.map((award) => (
          <div class="card glass-panel">
            <div class="card-header">
              <h3>{award['Award / Recognition']}</h3>
              <span class="badge internal">{award.Type}</span>
            </div>
            <p class="date">{award.Date && String(award.Date).substring(0, 10)}</p>
            <p class="description">{award['What It Recognized']}</p>
            <p class="meta">Given by: {award['Given By']} ({award['Their Role']})</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .page-header {
    margin-bottom: 4rem;
    text-align: center;
  }

  .achievement-count {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-top: 1rem;
  }

  .achievement-count strong {
    font-size: 2.5rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--accent-color);
  }

  .achievements-section {
    margin-bottom: 5rem;
  }

  .card-image-link {
    display: block;
    margin-bottom: 1rem;
    border-radius: 10px;
    overflow: hidden;
    transition: transform var(--transition-smooth);
  }

  .card-image-link:hover {
    transform: translateY(-3px);
  }

  .card-image {
    display: block;
    width: 100%;
    height: 220px;
    object-fit: cover;
    object-position: top;
    border-radius: 10px;
  }

  .achievements-section h2 {
    margin-bottom: 2rem;
    font-size: 2rem;
    color: var(--text-primary);
  }

  .cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform var(--transition-smooth), box-shadow var(--transition-smooth);
  }

  .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .card h3 {
    font-size: 1.25rem;
    margin: 0;
  }

  .badge {
    background-color: var(--text-primary);
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .badge.internal {
    background-color: #0d9488;
  }

  .badge.tech {
    background-color: var(--accent-color);
  }

  .date {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .description {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .meta {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .repo-stats {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .link-btn {
    display: inline-block;
    margin-top: auto;
    font-weight: 600;
    font-size: 0.9rem;
  }
</style>
