---
import Layout from '../layouts/Layout.astro';
import data from '../data/parsed_excel.json';

const conferences = data['Conferences (Speaker)'] || [];
const publications = data['Publications (Blog,Videos)'] || [];

function getYoutubeId(url) {
  if (!url || typeof url !== 'string') return null;
  const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([^&?]+)/);
  return match ? match[1] : null;
}

// Separate talks with videos to embed them
const talksWithVideo = conferences.filter(t => getYoutubeId(t.Youtube)).slice(0, 4); // Featured ones
const otherTalks = conferences.filter(t => !talksWithVideo.includes(t));
---

<Layout title="Talks & Media">
  <div class="container">
    <header class="page-header">
      <h1 class="text-gradient">Talks & Media</h1>
      <p class="subtitle">Public speaking, conference presentations, and technical videos.</p>
    </header>

    <section class="media-section">
      <h2>Featured Talks</h2>
      <div class="video-grid">
        {talksWithVideo.map((talk) => {
          const videoId = getYoutubeId(talk.Youtube);
          return (
            <div class="video-card glass-panel">
              <div class="video-wrapper">
                <iframe 
                  src={`https://www.youtube.com/embed/${videoId}`} 
                  title={talk.Title}
                  frameborder="0" 
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                  allowfullscreen>
                </iframe>
              </div>
              <div class="video-info">
                <h3>{talk.Title}</h3>
                <p class="meta">{talk.Conference} • {talk.Date && String(talk.Date).substring(0, 10)}</p>
                <div class="links">
                  {talk['Talk Link'] && <a href={talk['Talk Link']} target="_blank" class="link-btn">Event Info ↗</a>}
                  {talk.Slides && <a href={talk.Slides} target="_blank" class="link-btn">Slides ↗</a>}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <section class="media-section">
      <h2>More Conferences & Presentations</h2>
      <div class="list-grid">
        {otherTalks.map((talk) => (
          <div class="list-item glass-panel">
            <h3>{talk.Title}</h3>
            <p class="meta">{talk.Conference} • {talk.Date && String(talk.Date).substring(0, 10)}</p>
            <div class="links">
              {talk.Youtube && <a href={talk.Youtube} target="_blank" class="link-btn">Watch Video ↗</a>}
              {talk['Talk Link'] && <a href={talk['Talk Link']} target="_blank" class="link-btn">Event Info ↗</a>}
              {talk.Slides && <a href={talk.Slides} target="_blank" class="link-btn">Slides ↗</a>}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="media-section">
      <h2>Other Publications & Videos</h2>
      <div class="list-grid">
        {publications.map((pub) => (
          <div class="list-item glass-panel">
            <h3>{pub.Title}</h3>
            <p class="meta">{pub.channel} • {pub.date && String(pub.date).substring(0, 10)}</p>
            {pub.Link && <a href={pub.Link} target="_blank" class="link-btn">View Content ↗</a>}
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .page-header {
    margin-bottom: 4rem;
    text-align: center;
  }

  .subtitle {
    font-size: 1.25rem;
    color: var(--text-secondary);
    margin-top: 1rem;
  }

  .media-section {
    margin-bottom: 5rem;
  }

  .media-section h2 {
    margin-bottom: 2rem;
    font-size: 2rem;
    color: var(--text-primary);
  }

  .video-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .video-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .video-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .video-wrapper {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 aspect ratio */
    height: 0;
    width: 100%;
    background-color: #000;
  }

  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 16px 16px 0 0;
  }

  .video-info {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .video-info h3 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .meta {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .list-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .list-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .list-item {
    padding: 1.5rem;
    transition: transform var(--transition-smooth);
  }

  .list-item:hover {
    transform: translateY(-3px);
  }

  .list-item h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .links {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .link-btn {
    font-size: 0.85rem;
    font-weight: 600;
  }
</style>
