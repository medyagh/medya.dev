---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/paths';
---

<Layout title="Contact">
  <div class="container contact-container">
    <header class="page-header">
      <h1 class="text-gradient">Contact</h1>
    </header>

    <div class="content-grid">
      <div class="main-content">
        <section class="contact-section glass-panel">
          <p>
            Reach out if you'd like to chat about collaboration, opportunities, or anything else.
          </p>
          
          <div class="email-contact">
            <p class="email-label">Send me an email:</p>
            <div class="email-display" id="emailDisplay">
              <noscript>
                <span>Please enable JavaScript to see the email address</span>
              </noscript>
            </div>
            <p class="email-note">💡 Email is obfuscated to prevent spam</p>
          </div>
        </section>
      </div>

      <aside class="sidebar">
        <div class="glass-panel links-panel">
          <h3>Connect</h3>
          <ul class="social-links">
            <li><a href="https://x.com/medya_dev" target="_blank" rel="noopener noreferrer">Twitter (Personal) ↗</a></li>
            <li><a href="https://x.com/minikube_dev" target="_blank" rel="noopener noreferrer">Twitter (Minikube) ↗</a></li>
            <li><a href="https://www.linkedin.com/in/medyagh/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></li>
            <li><a href="https://github.com/kubernetes/minikube" target="_blank" rel="noopener noreferrer">Minikube GitHub ↗</a></li>
            <li><a href="https://profile.codersrank.io/user/medyagh" target="_blank" rel="noopener noreferrer">CodersRank Profile ↗</a></li>
          </ul>
          
        </div>
      </aside>
    </div>
  </div>
</Layout>

<script>
  // Decode and display email to prevent spam bots
  const email = atob('bWVkeWFAbWVkeWEuZGV2'); // Base64 encoded: medya@medya.dev
  const emailDisplay = document.getElementById('emailDisplay');
  
  if (emailDisplay) {
    const link = document.createElement('a');
    link.href = `mailto:${email}`;
    link.className = 'email-link';
    link.textContent = email;
    emailDisplay.appendChild(link);
  }
</script>

<style>
  .page-header {
    margin-bottom: 3rem;
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .content-grid {
      grid-template-columns: 2fr 1fr;
    }
  }

  .contact-section {
    padding: 2.5rem;
    margin-bottom: 2rem;
  }

  .contact-section p {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .email-contact {
    margin-top: 3rem;
    padding: 2rem;
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), rgba(59, 130, 246, 0.1));
    border-radius: 12px;
    border: 1px solid rgba(139, 92, 246, 0.2);
  }

  .email-label {
    color: var(--text-primary);
    font-weight: 600;
    margin-bottom: 1rem;
    font-size: 1.1rem;
  }

  .email-display {
    padding: 1rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    border: 1px solid rgba(139, 92, 246, 0.3);
    margin-bottom: 1rem;
  }

  .email-link {
    color: var(--accent-color, #8b5cf6);
    font-size: 1.25rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    word-break: break-all;
  }

  .email-link:hover {
    text-decoration: underline;
    color: var(--accent-hover, #a78bfa);
  }

  .email-note {
    color: var(--text-secondary);
    font-size: 0.95rem;
    font-style: italic;
  }

  .links-panel {
    padding: 2rem;
    position: sticky;
    top: calc(var(--nav-height) + 2rem);
  }

  .links-panel h3 {
    margin-bottom: 1.5rem;
    font-size: 1.25rem;
  }

  .social-links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .social-links a {
    display: inline-block;
    font-weight: 500;
    font-size: 1.05rem;
  }
  
  .w-full {
    width: 100%;
  }
</style>
