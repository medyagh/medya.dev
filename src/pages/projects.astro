---
import Layout from '../layouts/Layout.astro';
import data from '../data/parsed_excel.json';

const githubRepos = data['Github Repos'] || [];

// Sort repos by priority
const topRepos = githubRepos
  .filter(r => r['Repo / Project'])
  .sort((a, b) => (a.Priority || 99) - (b.Priority || 99))
  .slice(0, 10);

function formatCount(n: number | null | undefined): string {
  if (!n) return '';
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1)}M`;
  if (n >= 1_000) return `${Math.round(n / 1_000)}K`;
  return String(n);
}
---

<Layout title="Projects">
  <div class="container">
    <header class="page-header">
      <h1 class="text-gradient">Key Open Source Projects</h1>
      <p class="subtitle">A showcase of the major repositories and tools I have built and maintained.</p>
    </header>

    <section class="achievements-section">
      <div class="cards-grid">
        {topRepos.map((repo) => (
          <div class="card glass-panel">
            <div class="card-header">
              <h3>{repo['Repo / Project']}</h3>
              <span class="badge tech">{repo['Primary language'] || 'Multi'}</span>
            </div>
            {(repo['GitHub downloads'] ?? 0) > 10000 && (
              <div class="download-badge">
                <span class="download-icon">⬇</span>
                <span>{formatCount(repo['GitHub downloads'])} downloads</span>
              </div>
            )}
            <p class="meta"><strong>Role:</strong> {repo['Role / relationship']}</p>
            <p class="description">{repo['Impact story / evidence use']}</p>
            <div class="repo-stats">
              {repo.Stars ? <span>⭐ {repo.Stars}</span> : null}
              {repo.Forks ? <span>🍴 {repo.Forks}</span> : null}
              {repo['Dependent repos'] ? <span>🔗 {formatCount(repo['Dependent repos'])} dependents</span> : null}
            </div>
            <a href={repo.URL} target="_blank" rel="noopener noreferrer" class="link-btn">View Repository ↗</a>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .page-header {
    margin-bottom: 4rem;
    text-align: center;
  }

  .subtitle {
    font-size: 1.25rem;
    color: var(--text-secondary);
    margin-top: 1rem;
  }

  .achievements-section {
    margin-bottom: 5rem;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform var(--transition-smooth), box-shadow var(--transition-smooth);
  }

  .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .card h3 {
    font-size: 1.25rem;
    margin: 0;
  }

  .badge {
    background-color: var(--text-primary);
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .badge.tech {
    background-color: var(--accent-color);
  }

  .download-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: flex-start;
    margin-bottom: 1rem;
    padding: 0.35rem 0.9rem;
    border-radius: 20px;
    background: linear-gradient(135deg, var(--accent-color) 0%, #0ea5e9 100%);
    color: white;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .download-icon {
    font-size: 0.9rem;
  }

  .description {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .meta {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .repo-stats {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .link-btn {
    display: inline-block;
    margin-top: auto;
    font-weight: 600;
    font-size: 0.9rem;
  }
</style>
